{
	auto_https disable_redirects
	{{DEFAULT_SNI}}
	{{STRICT_SNI_HOST}}
}

{{PUBLIC_HOST}} {
	log
	@compressible not path /__remote_everything_pair /__remote_everything*
	encode @compressible zstd gzip

	tls {
		issuer acme {
			disable_http_challenge
			{{ACME_PROFILE}}
		}
		client_auth {
			mode verify_if_given
			trust_pool file "{{DEVICE_CA_FILE}}" "{{TUNNEL_CA_FILE}}"
		}
	}

	@pair path /__remote_everything_pair
	handle @pair {
		reverse_proxy "{{PAIRING_UPSTREAM}}"
	}

	@tunnel expression `path('/~!frp') && {tls_client_issuer} == "{{TUNNEL_ISSUER_DN}}"`
	handle @tunnel {
		reverse_proxy "{{FRPS_UPSTREAM}}"
	}

	# Everything a device this entrance issued a credential to sends is the
	# gateway's, whether it is the control surface it asks for or the application
	# traffic it carries: both leave here for the same upstream, and the fingerprint
	# of the certificate this entrance verified travels with it. The one request
	# that can arrive without one is the pairing endpoint above.
	@device expression `{tls_client_issuer} == "{{DEVICE_ISSUER_DN}}"`
	handle @device {
		reverse_proxy "{{STATUS_UPSTREAM}}" {
			header_up X-Remote-Everything-Client-Fingerprint {tls_client_fingerprint}
		}
	}

	respond 401
}
