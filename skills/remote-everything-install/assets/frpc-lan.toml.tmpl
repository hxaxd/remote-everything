serverAddr = "{{SERVER_HOST}}"
serverPort = {{SERVER_PORT}}
loginFailExit = false
transport.protocol = "tcp"
transport.wireProtocol = "v2"
transport.poolCount = 32
transport.tls.enable = true
transport.tls.certFile = "{{TUNNEL_CLIENT_CERT}}"
transport.tls.keyFile = "{{TUNNEL_CLIENT_KEY}}"
transport.tls.trustedCaFile = "{{TUNNEL_CA_FILE}}"
transport.tls.serverName = "{{TUNNEL_SERVER_NAME}}"
auth.method = "token"
auth.tokenSource.type = "file"
auth.tokenSource.file.path = "{{FRPS_TOKEN_FILE}}"
log.to = "{{FRPC_LOG}}"
log.level = "info"

[[proxies]]
name = "node-{{NODE_ID}}"
type = "tcp"
localIP = "{{NODE_HOST}}"
localPort = {{NODE_PORT}}
remotePort = {{NODE_TUNNEL_PORT}}
