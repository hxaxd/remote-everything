    },
    {
      "name": "pairing-reject-credential-not-base64",
      "kind": "pairing",
      "payload": {
        "ok": true,
        "device_name": "phone",
        "certificate_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "credential_format": "pkcs12",
        "credential_pkcs12": "not_base64!!",
        "pending_expires_at": "2026-09-17T10:00:00Z"
      },
      "expect": "reject",
      "reason": "credential_pkcs12 must be non-empty and base64-decodable, because the client has to install it as a PKCS#12 archive."
    },
    {
      "name": "pairing-reject-expiry-not-rfc3339",
      "kind": "pairing",
      "payload": {
        "ok": true,
        "device_name": "phone",
        "certificate_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
