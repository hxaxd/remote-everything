    },
    {
      "name": "pairing-reject-credential-format-not-pkcs12",
      "kind": "pairing",
      "payload": {
        "ok": true,
        "device_name": "phone",
        "certificate_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "credential_format": "pem",
        "credential_pkcs12": "MIIB",
        "pending_expires_at": "2026-09-17T10:00:00Z"
      },
      "expect": "reject",
