    {
      "name": "catalog-accept-offline-empty",
      "kind": "catalog",
      "payload": {
        "ok": true,
        "computer_connected": false,
        "code": "computer_offline",
        "apps": []
      },
      "expect": "accept",
      "reason": "A node that is off is an answer with an empty app list, not a refusal."
    },
    {
      "name": "catalog-reject-ok-false",
      "kind": "catalog",
      "payload": {
        "ok": false,
        "computer_connected": true,
        "code": "ready",
        "apps": []
      },
      "expect": "reject",
      "reason": "ok is const true in a catalog answer; a catalog that says it is not ok is not a catalog."
    },
    {
      "name": "catalog-reject-unknown-code",
      "kind": "catalog",
      "payload": {
        "ok": true,
        "computer_connected": true,
        "code": "offline",
        "apps": []
      },
      "expect": "reject",
      "reason": "The catalog code is the closed set ready|computer_offline; an unknown value is refused, never defaulted."
    },
    {
      "name": "catalog-reject-code-vs-connection",
      "kind": "catalog",
      "payload": {
        "ok": true,
        "computer_connected": true,
        "code": "computer_offline",
        "apps": []
      },
      "expect": "reject",
      "reason": "code and computer_connected say the same thing twice: connected requires ready and disconnected requires computer_offline."
    },
