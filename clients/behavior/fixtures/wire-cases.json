    {
      "name": "apps-reject-id-pattern",
      "kind": "apps",
      "payload": {
        "ok": true,
        "computer_connected": true,
        "code": "ready",
        "apps": [
          {
            "id": "Files",
            "name": "文件",
            "description": "",
