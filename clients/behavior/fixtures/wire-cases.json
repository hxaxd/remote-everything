{
  "cases": [
    {
      "name": "nodes-accept-valid",
      "kind": "nodes",
      "payload": {
        "ok": true,
        "nodes": [
          {
            "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "name": "客厅电脑"
          }
        ]
      },
      "expect": "accept",
      "reason": "A nodes answer with one 64-lowercase-hex node id and a non-empty name is the contract's shape."
    },
    {
      "name": "nodes-reject-unknown-field",
      "kind": "nodes",
      "payload": {
        "ok": true,
        "nodes": [],
        "count": 0
      },
      "expect": "reject",
      "reason": "A field outside ok and nodes is a body the client does not understand."
    },
    {
      "name": "nodes-reject-missing-nodes",
      "kind": "nodes",
      "payload": {
        "ok": true
      },
      "expect": "reject",
      "reason": "nodes is required; a body without it is not a nodes answer."
    },
    {
      "name": "nodes-reject-id-not-lowercase-hex",
      "kind": "nodes",
      "payload": {
        "ok": true,
        "nodes": [
          {
            "id": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "name": "客厅电脑"
          }
        ]
      },
      "expect": "reject",
      "reason": "nodes[].id must match ^[a-f0-9]{64}$ — uppercase hex is a different string and a different node."
    },
    {
      "name": "nodes-reject-empty-name",
      "kind": "nodes",
      "payload": {
        "ok": true,
        "nodes": [
          {
            "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "name": ""
          }
        ]
      },
      "expect": "reject",
      "reason": "nodes[].name has minLength 1, so an empty name is refused."
    },
