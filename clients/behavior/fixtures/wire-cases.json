    {
      "name": "error-reject-ok-true",
      "kind": "error",
      "payload": {
        "ok": true,
        "code": "unauthorized"
      },
      "expect": "reject",
      "reason": "ok is const false in a refusal; a body that says it succeeded is not the error shape."
    },
    {
      "name": "error-reject-unknown-code",
      "kind": "error",
      "payload": {
        "ok": false,
        "code": "too_many_devices"
      },
      "expect": "reject",
      "reason": "The refusal code is the closed set of nineteen; a code outside it is not a decision this client can make."
    },
    {
      "name": "activation-accept-catalog",
      "kind": "activation",
      "payload": {
        "ok": true,
        "computer_connected": true,
        "code": "ready",
        "apps": [
          {
            "id": "jellyfin",
            "name": "Jellyfin",
            "description": "媒体库",
            "icon": "🎬",
            "accent": "#2563eb",
            "launch_fragment": "",
            "computer_connected": true,
            "enabled": true,
            "running": true,
            "code": "ready"
          }
        ]
      },
      "expect": "accept",
      "reason": "A successful activation is answered with the connected variant of a catalog, never the offline one."
    },
    {
      "name": "activation-reject-disconnected",
      "kind": "activation",
      "payload": {
        "ok": true,
        "computer_connected": false,
        "code": "ready",
        "apps": [
          {
            "id": "jellyfin",
            "name": "Jellyfin",
            "description": "媒体库",
            "icon": "🎬",
            "accent": "#2563eb",
            "launch_fragment": "",
            "computer_connected": true,
            "enabled": true,
            "running": true,
            "code": "ready"
          }
        ]
      },
      "expect": "reject",
      "reason": "Activation is answered with a catalog only after the node answered, so the catalog variant is always the connected one; admitting a device against computer_connected=false would activate it against a node that is not there."
    },
    {
      "name": "activation-reject-not-ready",
      "kind": "activation",
      "payload": {
        "ok": true,
        "computer_connected": true,
        "code": "registry_unavailable",
        "apps": [
          {
            "id": "jellyfin",
            "name": "Jellyfin",
            "description": "媒体库",
            "icon": "🎬",
            "accent": "#2563eb",
            "launch_fragment": "",
            "computer_connected": true,
            "enabled": true,
            "running": true,
            "code": "ready"
          }
        ]
      },
      "expect": "reject",
      "reason": "Only code=ready admits a device: registry_unavailable is a connected node that cannot say what it runs, and a client that treated it as success would show an empty node as usable."
    },
    {
      "name": "activation-accept-approval-pending",
      "kind": "activation",
      "payload": {
        "ok": false,
        "code": "approval_pending"
      },
      "expect": "accept",
      "reason": "HTTP 202 with approval_pending is the device paired and its operator not having confirmed yet — an answer, not a failure."
    },
    {
      "name": "release-accept-this-build",
      "kind": "release",
      "payload": {
        "schema": 1,
        "versionName": "3.5.0",
        "buildNumber": 28,
        "protocolVersion": 1,
        "minimumPlatforms": {
          "androidSdk": 30,
          "ios": "17.0",
          "harmonyApi": "24"
        }
      },
      "expect": "accept",
      "reason": "The published manifest is the one this build carries: schema 1, semantic version, build and protocol at least 1, and all three platforms named."
    },
    {
      "name": "release-reject-schema-not-1",
      "kind": "release",
      "payload": {
        "schema": 2,
        "versionName": "3.5.0",
        "buildNumber": 28,
        "protocolVersion": 1,
        "minimumPlatforms": {
          "androidSdk": 30,
          "ios": "17.0",
          "harmonyApi": "24"
        }
      },
      "expect": "reject",
      "reason": "schema is const 1; a manifest of another schema is not one this client reads."
    },
    {
      "name": "release-reject-version-name-not-semver",
      "kind": "release",
      "payload": {
        "schema": 1,
        "versionName": "3.5",
        "buildNumber": 28,
        "protocolVersion": 1,
        "minimumPlatforms": {
          "androidSdk": 30,
          "ios": "17.0",
          "harmonyApi": "24"
        }
      },
      "expect": "reject",
      "reason": "versionName must match ^\\d+\\.\\d+\\.\\d+$, exactly three numeric components."
    },
    {
      "name": "release-reject-build-number-zero",
      "kind": "release",
      "payload": {
        "schema": 1,
        "versionName": "3.5.0",
        "buildNumber": 0,
        "protocolVersion": 1,
        "minimumPlatforms": {
          "androidSdk": 30,
          "ios": "17.0",
          "harmonyApi": "24"
        }
      },
      "expect": "reject",
      "reason": "buildNumber is monotonically increasing from 1, so zero is not a build this client knows (the same rule holds for protocolVersion)."
    },
    {
      "name": "release-reject-unknown-platform-field",
      "kind": "release",
      "payload": {
        "schema": 1,
        "versionName": "3.5.0",
        "buildNumber": 28,
        "protocolVersion": 1,
        "minimumPlatforms": {
          "androidSdk": 30,
          "ios": "17.0",
          "harmonyApi": "24",
          "windows": "11"
        }
      },
      "expect": "reject",
      "reason": "minimumPlatforms names exactly the three platforms of this project; a fourth is a field the client does not understand."
    }
  ]
}
