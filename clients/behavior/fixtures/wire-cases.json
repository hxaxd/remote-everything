    },
    {
      "name": "pairing-reject-fingerprint-not-hex64",
      "kind": "pairing",
      "payload": {
        "ok": true,
        "device_name": "phone",
        "certificate_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
