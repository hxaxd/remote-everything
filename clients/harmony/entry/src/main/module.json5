{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/app/EntryAbilityStage.ets",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/app/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:ic_launcher_layered",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:ic_launcher_flat",
        "startWindowBackground": "$color:start_window_background",
        // The app declares no orientation: "unspecified" lets the system decide,
        // and an application's own panel is the one thing that may hold the screen
        // (ui-contract §6, revised) — the web host asks for it while that
        // application is open and gives it back on the way out. Nothing else
        // calls setPreferredOrientation.
        "orientation": "unspecified",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            // An invitation link opens the app straight into the add-node flow.
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              {
                "scheme": "remote-everything",
                "host": "setup"
              }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        // Which network this device is on decides which remembered route is used and
        // when those routes are re-decided (ui-contract §4). Nothing about the network
        // itself is read, recorded or sent.
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.ACCESS_CERT_MANAGER"
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:camera_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        // What an application's page may ask of the device: the microphone for a
        // call, the location for a map. Each is granted only to a page the gateway
        // serves, and only after the platform's own question.
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:location_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:location_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ]
  }
}
