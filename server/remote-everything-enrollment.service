[Unit]
Description=Remote Everything Device Enrollment
After=network.target

[Service]
Type=simple
User=remote-everything-enroll
Group=remote-everything-enroll
ExecStart=/usr/local/sbin/remote-everything-gateway enrollment-server
Restart=always
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/remote-everything-enrollment
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
