{
	admin 127.0.0.1:2019
	default_sni __PUBLIC_HOST__
	auto_https disable_redirects
	servers {
		strict_sni_host insecure_off
	}
}

https://__PUBLIC_HOST__ {
	tls {
		issuer acme {
			profile shortlived
			disable_http_challenge
		}
		client_auth {
			mode require_and_verify
			trust_pool file /etc/remote-everything-gateway/client-trust.pem
		}
	}

	route {
		@bootstrap expression `{tls_client_fingerprint} == "__BOOTSTRAP_FINGERPRINT__"`
		handle @bootstrap {
			handle /__remote_everything_enroll/* {
				reverse_proxy 127.0.0.1:58631 {
					header_up X-Remote-Everything-Bootstrap-Fingerprint {tls_client_fingerprint}
				}
			}
			respond 403
		}

		handle {
			@enrollment_path path /__remote_everything_enroll/*
			respond @enrollment_path 403

			handle /__remote_everything/* {
				reverse_proxy 127.0.0.1:58629
			}

			handle /~!frp* {
				reverse_proxy 127.0.0.1:7000 {
					flush_interval -1
					transport http {
						dial_timeout 3s
					}
				}
			}

			@forbidden_remote path /__local_remote_control /api/v1/terminals /api/v1/terminals/* /api/v1/shutdown
			respond @forbidden_remote 403

			reverse_proxy 127.0.0.1:58628 {
				header_up Host __PUBLIC_HOST__
				flush_interval -1
				transport http {
					dial_timeout 3s
					response_header_timeout 30s
				}
			}
		}
	}

	handle_errors {
		rewrite * /status
		reverse_proxy 127.0.0.1:58629
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}
